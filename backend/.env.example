PUBLIC_APP_ORIGIN=http://127.0.0.1:5500
GOOGLE_OAUTH_WEB_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_WEB_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_PROJECT_ID=your-google-cloud-project-id
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=swedencentral
AZURE_SPEECH_TTS_VOICE_KK=kk-KZ-AigulNeural
AZURE_SPEECH_TTS_VOICE_RU=ru-RU-SvetlanaNeural
AZURE_SPEECH_TTS_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3
VOICE_ASSISTANT_NAME=Ayla
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/users/drive/callback/
FRONTEND_SUCCESS_URL=http://127.0.0.1:5500/
GOOGLE_OAUTH_FRONTEND_SUCCESS_URL=http://127.0.0.1:5500/
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\your-google-service-account.json
# Optional: curated Google Slides master templates copied and filled by the app.
# Expected structure: cover slide, one content slide, closing slide.
# Placeholders: {{PRESENTATION_TITLE}}, {{PRESENTATION_SUBTITLE}}, {{SLIDE_TITLE}}, {{SLIDE_BODY}}, {{SLIDE_NUMBER}}
# GOOGLE_SLIDES_MASTER_TEMPLATES_JSON=[{"id":"executive-master","source_presentation_id":"your-google-slides-template-id","tone":"executive","labels":{"kaz":"Executive Dark","rus":"Executive Dark","eng":"Executive Dark"}}]
